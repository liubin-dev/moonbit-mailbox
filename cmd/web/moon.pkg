import {
  "liubin-dev/mailbox" @lib,
  "moonbitlang/core/encoding/base64",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "maildir_name",
        "maildir_flags",
        "mime_summary",
        "header_display",
        "body_display",
        "attachment_name",
      ],
      "format": "esm",
    },
  },
)
